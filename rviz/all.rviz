Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Image
      Enabled: false
      Name: Motion - Custom
      Normalize Range: true
      Queue Size: 2
      Topic:
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /motion_extractor/image
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Motion - 1 second
      Normalize Range: true
      Queue Size: 2
      Topic:
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /motion_extractor/image_1s
    - Class: rviz_default_plugins/Image
      Enabled: false
      Name: Motion - 5 seconds
      Normalize Range: true
      Queue Size: 2
      Topic:
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /motion_extractor/image_5s
    - Class: rviz_default_plugins/Image
      Enabled: false
      Name: Motion - 30 seconds
      Normalize Range: true
      Queue Size: 2
      Topic:
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /motion_extractor/image_30s
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Motion - 60 seconds
      Normalize Range: true
      Queue Size: 2
      Topic:
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /motion_extractor/image_60s
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Motion - Startup frame
      Normalize Range: true
      Queue Size: 2
      Topic:
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /motion_extractor/image_start
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: camera_link
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 10
      Name: Current View
Window Geometry:
  Height: 900
  Width: 1600
