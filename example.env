# Host identity used when building container users.
HOST_UID=1000
HOST_GID=1000

# ROS 2 discovery settings. Keep ROS_DOMAIN_ID consistent across services.
ROS_DOMAIN_ID=10
ROS_LOCALHOST_ONLY=0

# RealSense selection and frame configuration.
# Leave blank to use the first available camera.
REALSENSE_SERIAL_NUMBER=
REALSENSE_CAMERA_NAME=camera
REALSENSE_CAMERA_NAMESPACE=camera
REALSENSE_BASE_FRAME_ID=link
REALSENSE_TF_PARENT_FRAME=sensors_base_link
REALSENSE_TF_CHILD_FRAME=camera_link
REALSENSE_TF_X=0.10
REALSENSE_TF_Y=-0.25
REALSENSE_TF_Z=0.0
REALSENSE_TF_ROLL=0.0
REALSENSE_TF_PITCH=0.0
REALSENSE_TF_YAW=1.57079632679
REALSENSE_ENABLE_DEPTH=true
REALSENSE_ENABLE_COLOR=true
REALSENSE_ENABLE_INFRA1=false
REALSENSE_ENABLE_INFRA2=false
REALSENSE_ENABLE_GYRO=false
REALSENSE_ENABLE_ACCEL=false
REALSENSE_ALIGN_DEPTH=false
REALSENSE_PUBLISH_TF=true
REALSENSE_LAUNCH_RVIZ=false

# Celestial localisation topics and processing parameters.
CELESTIAL_CAMERA_TOPIC=/camera/camera/color/image_raw
CELESTIAL_SKY_MAP_TOPIC=/sky_map
CELESTIAL_OBSERVATIONS_TOPIC=/celestial_observations
CELESTIAL_POSE_TOPIC=/celestial_pose
CELESTIAL_FIX_TOPIC=/celestial_fix
CELESTIAL_PANORAMA_WIDTH=2048
CELESTIAL_PANORAMA_HEIGHT=1024
CELESTIAL_CALIBRATION_FILE=
CELESTIAL_DETECT_STARS=true
CELESTIAL_DETECT_SUN=true
CELESTIAL_DETECT_MOON=true
CELESTIAL_STAR_THRESHOLD=5.0
# Conservative horizon cutoff for the bundled simulator landscape; calibrate for another camera.
CELESTIAL_STAR_MIN_ELEVATION_DEGREES=25.0
CELESTIAL_STAR_MAX_CANDIDATES=64
# Empty uses tetra3's bundled offline database; set a path for a custom database.
CELESTIAL_STAR_DATABASE_PATH=
CELESTIAL_STAR_FOV_DEGREES=30.0
CELESTIAL_STAR_FOV_MAX_ERROR_DEGREES=3.0
CELESTIAL_STAR_TILE_SIZE=512
CELESTIAL_STAR_MATCH_RADIUS=0.02
CELESTIAL_STAR_MATCH_THRESHOLD=0.001
CELESTIAL_STAR_MIN_MATCHES=4
CELESTIAL_MIN_CONFIDENCE=0.5
CELESTIAL_USE_SUN=true
CELESTIAL_USE_MOON=true
CELESTIAL_USE_STARS=true
CELESTIAL_FIXED_ALTITUDE=0.0
CELESTIAL_INITIAL_LATITUDE=51.5
CELESTIAL_INITIAL_LONGITUDE=-0.1
CELESTIAL_SOLVER_MAX_NFEV=30
CELESTIAL_PUBLISH_TF=true
CELESTIAL_MAP_FRAME=map
CELESTIAL_BASE_FRAME=base_link
CELESTIAL_LOAD_GPS_SERVICE=/test/load_gps
CELESTIAL_RANDOM_EVALUATION_SERVICE=/test/run_random_evaluation
CELESTIAL_POSE_DEBUG_FILENAME=pose.json
CELESTIAL_RANDOM_METRICS_FILENAME=random_localisation_metrics.csv
CELESTIAL_GMM_BOUNDARIES_FILENAME=gmm_boundaries.json
# The detector snapshots this file at startup and excludes strongly harmful stars
# from the enabled error groups. Use a different filename for a fixed copy.
CELESTIAL_STAR_BENEFIT_METRICS_FILENAME=simulated_location_filter_samples*.csv
CELESTIAL_STAR_BENEFIT_MIN_SCORE=-0.1
CELESTIAL_STAR_BENEFIT_MIN_PRESENT_COUNT=3
CELESTIAL_STAR_BENEFIT_MIN_ABSENT_COUNT=2
CELESTIAL_STAR_BENEFIT_USE_HIGH_ERROR_GROUP=true
CELESTIAL_STAR_BENEFIT_USE_MEDIUM_ERROR_GROUP=false
CELESTIAL_RANDOM_EVALUATION_TIMEOUT=180.0
CELESTIAL_RANDOM_EVALUATION_POLL_INTERVAL=0.25
CELESTIAL_SKY_MAP_FRAME=sky_map
CELESTIAL_SIMULATION_FACE_SIZE=512
CELESTIAL_SIMULATION_FACE_FOV=95.0
CELESTIAL_SIMULATION_RENDER_TIMEOUT=60.0
# Hide Stellarium object/constellation names in generated maps by default.
CELESTIAL_SIMULATION_SHOW_LABELS=false
# Render the bundled Guereins ground landscape by default.
CELESTIAL_SIMULATION_ENABLE_LANDSCAPE=true
CELESTIAL_SIMULATION_LANDSCAPE_KEY=guereins
CELESTIAL_STELLARIUM_ASSET_DIR=./celestial_localisation/stellarium_assets
CELESTIAL_STELLARIUM_ENGINE_JS=/opt/stellarium/stellarium-web-engine.js
CELESTIAL_STELLARIUM_SOURCE_DIR=./stellarium-web-engine
CELESTIAL_STELLARIUM_ENGINE_WASM=/opt/stellarium/stellarium-web-engine.wasm
CELESTIAL_STELLARIUM_DATA_ROOT=/opt/stellarium/data
# Leave blank to use the Playwright-managed browser installed in the image.
CELESTIAL_BROWSER_EXECUTABLE=
