# Host identity used when building container users.
HOST_UID=1000
HOST_GID=1000

# ROS 2 discovery settings. Keep ROS_DOMAIN_ID consistent across services.
ROS_DOMAIN_ID=10
ROS_LOCALHOST_ONLY=0

# RealSense selection and frame configuration.
# Leave blank to use the first available camera.
REALSENSE_SERIAL_NUMBER=
REALSENSE_CAMERA_NAME=camera
REALSENSE_CAMERA_NAMESPACE=camera
REALSENSE_BASE_FRAME_ID=link
REALSENSE_TF_PARENT_FRAME=sensors_base_link
REALSENSE_TF_CHILD_FRAME=camera_link
REALSENSE_TF_X=0.10
REALSENSE_TF_Y=-0.25
REALSENSE_TF_Z=0.0
REALSENSE_TF_ROLL=0.0
REALSENSE_TF_PITCH=0.0
REALSENSE_TF_YAW=1.57079632679
REALSENSE_ENABLE_DEPTH=true
REALSENSE_ENABLE_COLOR=true
REALSENSE_ENABLE_INFRA1=false
REALSENSE_ENABLE_INFRA2=false
REALSENSE_ENABLE_GYRO=false
REALSENSE_ENABLE_ACCEL=false
REALSENSE_ALIGN_DEPTH=false
REALSENSE_PUBLISH_TF=true
REALSENSE_LAUNCH_RVIZ=false

# Celestial localisation topics and processing parameters.
CELESTIAL_CAMERA_TOPIC=/camera/camera/color/image_raw
CELESTIAL_SKY_MAP_TOPIC=/sky_map
CELESTIAL_OBSERVATIONS_TOPIC=/celestial_observations
CELESTIAL_POSE_TOPIC=/celestial_pose
CELESTIAL_FIX_TOPIC=/celestial_fix
CELESTIAL_PANORAMA_WIDTH=2048
CELESTIAL_PANORAMA_HEIGHT=1024
CELESTIAL_CALIBRATION_FILE=
CELESTIAL_DETECT_STARS=true
CELESTIAL_DETECT_SUN=true
CELESTIAL_DETECT_MOON=true
CELESTIAL_STAR_THRESHOLD=5.0
CELESTIAL_MIN_CONFIDENCE=0.5
CELESTIAL_USE_SUN=true
CELESTIAL_USE_MOON=true
CELESTIAL_USE_STARS=true
CELESTIAL_FIXED_ALTITUDE=0.0
CELESTIAL_INITIAL_LATITUDE=51.5
CELESTIAL_INITIAL_LONGITUDE=-0.1
CELESTIAL_PUBLISH_TF=true
CELESTIAL_MAP_FRAME=map
CELESTIAL_BASE_FRAME=base_link
