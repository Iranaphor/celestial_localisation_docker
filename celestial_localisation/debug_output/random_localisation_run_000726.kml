<?xml version='1.0' encoding='utf-8'?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>Random localisation run 726</name>
    <description>Orange markers show estimated fixes. The larger translucent summary markers show the summary estimate and ground truth.</description>
    <Style id="estimated-step">
      <IconStyle>
        <color>ff0066ff</color>
        <scale>0.8</scale>
        <Icon>
          <href>http://maps.google.com/mapfiles/kml/pushpin/orange-pushpin.png</href>
        </Icon>
      </IconStyle>
    </Style>
    <Style id="estimated-summary">
      <IconStyle>
        <color>990066ff</color>
        <scale>1.8</scale>
        <Icon>
          <href>http://maps.google.com/mapfiles/kml/pushpin/orange-pushpin.png</href>
        </Icon>
      </IconStyle>
    </Style>
    <Style id="ground-truth-summary">
      <IconStyle>
        <color>99ff6600</color>
        <scale>1.8</scale>
        <Icon>
          <href>http://maps.google.com/mapfiles/kml/pushpin/blue-pushpin.png</href>
        </Icon>
      </IconStyle>
    </Style>
    <Style id="estimated-path">
      <LineStyle>
        <color>cc0066ff</color>
        <width>4</width>
      </LineStyle>
    </Style>
