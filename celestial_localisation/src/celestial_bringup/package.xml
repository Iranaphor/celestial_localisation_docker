<?xml version="1.0"?>
<package format="3">
  <name>celestial_bringup</name>
  <version>0.1.0</version>
  <description>Launch files and configuration bringing up the full celestial localisation pipeline.</description>
  <maintainer email="primordia@live.com">james</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>sky_mapper</exec_depend>
  <exec_depend>celestial_detector</exec_depend>
  <exec_depend>celestial_localizer</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
