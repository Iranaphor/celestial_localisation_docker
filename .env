HOST_UID=1001
HOST_GID=1001

ROS_DOMAIN_ID=10
ROS_LOCALHOST_ONLY=0

REALSENSE_SERIAL_NUMBER=148522071453

MOTION_INPUT_TOPIC=/camera/camera/color/image_raw
MOTION_OUTPUT_TOPIC=/motion_extractor/image
MOTION_HISTORY_SECONDS=1.0
MOTION_OPACITY=0.5

#CELESTIAL_TEST_SKY_MAP_IMAGE_FILE=/home/ros/ros2_ws/src/celestial_bringup/data/sample_sky_map.png
CELESTIAL_TEST_SKY_MAP_IMAGE_FILE=/home/ros/ros2_ws/src/celestial_bringup/data/skybox_field.jpg

# Directory /test/publish_sky_map resolves its 'filename' request field against.
# Call with an empty filename to fall back to CELESTIAL_TEST_SKY_MAP_IMAGE_FILE above.
CELESTIAL_TEST_SKY_MAP_IMAGE_DIR=/home/ros/ros2_ws/src/celestial_bringup/data


# Star detection is a stub (see celestial_detector/star_identifier.py) and
# never contributes to the pose solve yet, so skip it to run faster.
CELESTIAL_DETECT_STARS=true
